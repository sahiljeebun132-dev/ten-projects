# Port the HTTP + WebSocket server listens on
PORT=3000

# Secret used to sign the session cookie shared by Express and Socket.IO.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the SQLite file location (default db/chat.sqlite)
# DB_PATH=db/chat.sqlite

# Optional: set to production to enable secure cookies + static caching
# NODE_ENV=development
