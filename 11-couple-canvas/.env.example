# All optional – the app runs with none of these set.
PORT=3000

# Web Push (VAPID) keys. If unset, a key pair is generated on first boot and saved to data/vapid.json.
# Generate your own with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can use to reach the server operator.
VAPID_SUBJECT=mailto:you@example.com

# Where the SQLite database lives (default: ./data/scribble.db)
DB_FILE=
DATA_DIR=
