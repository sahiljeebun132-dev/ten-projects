# Northwind Goods - DEMO STORE
# Copy to .env and adjust. Nothing here connects to a real service.

# Port the demo server listens on
PORT=4005

# Session cookie signing secret. Any random string is fine for a local demo.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override where the SQLite file lives (defaults to db/store.sqlite)
# DB_PATH=db/store.sqlite

# Set to "production" to make session cookies secure-only (needs HTTPS).
# NODE_ENV=development
