# Copy to .env and adjust. Never commit the real .env file.

# Port the HTTP server listens on
PORT=3000

# Secret used to sign session cookies.
# REQUIRED when NODE_ENV=production (the server refuses to boot without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# development | production  (production enables secure cookies and hides stack traces)
NODE_ENV=development

# --- optional ---------------------------------------------------------------
# SITE_TITLE=Inkwell
# SITE_DESCRIPTION=Notes on building things with Node, SQLite and a bit of markdown.
# POSTS_PER_PAGE=5
# DB_FILE=db/blog.sqlite
