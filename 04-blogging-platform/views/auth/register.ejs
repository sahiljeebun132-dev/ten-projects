<%- include('../partials/head', { title: title }) %>

<section class="auth-card">
  <h1>Create an account</h1>
  <p class="hero-sub">New accounts get the <strong>author</strong> role.</p>

  <% if (errors.length) { %>
    <ul class="form-error" role="alert">
      <% errors.forEach(function (msg) { %><li><%= msg %></li><% }); %>
    </ul>
  <% } %>

  <form action="/register" method="post" class="stack-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="name">Display name</label>
    <input type="text" id="name" name="name" required maxlength="60" value="<%= values.name || '' %>">

    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autocomplete="email" value="<%= values.email || '' %>">

    <label for="password">Password <span class="hint">(at least 8 characters)</span></label>
    <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">

    <label for="password2">Confirm password</label>
    <input type="password" id="password2" name="password2" required minlength="8" autocomplete="new-password">

    <button class="btn" type="submit">Create account</button>
  </form>

  <p class="auth-alt">Already registered? <a href="/login">Log in</a>.</p>
</section>

<%- include('../partials/footer') %>
